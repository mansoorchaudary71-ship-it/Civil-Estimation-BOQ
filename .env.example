# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required to send emails via Resend.
# Configure this in the AI Studio Settings / Secrets panel.
RESEND_API_KEY="re_..."

# CONTACT_EMAIL: Where the contact form emails should be delivered.
CONTACT_EMAIL="your-email@example.com"

# JWT_SECRET: Signing secret for the dev server's JWT auth (server.ts).
# REQUIRED to start the dev server; it fails to start if this is unset.
# Generate a fresh long random secret (e.g. `openssl rand -hex 32`) and
# never commit the real value. A previously hardcoded secret was published
# in the public site artifact and must be treated as compromised — do not
# reuse it here or anywhere else.
JWT_SECRET="<generate-a-long-random-secret>"
